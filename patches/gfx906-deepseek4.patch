+// src/kernels/cuda/gfx906_stubs.cu
+//
+// gfx906 (MI50 / Radeon VII, wave64) builds without `qwen35_fast.cu`: that TU is built on rocWMMA and raw v_wmma
+// builtins, and rocWMMA refuses this arch at compile time ("static assertion failed: Unsupported architecture").
+// It holds no gfx906-capable code and the Qwen3.5 family is not what this build targets, so it is out of the
+// target and the entry points the rest of the tree references are defined here.
+//
+// `glm_batch.cu` is NOT stubbed: only its WMMA kernels are guarded out (STRATA_HIP_WMMA=0), and its ordinary HIP
+// kernels - the bf16/f16 conversions, HC, the DSA indexer, KDA - compile for gfx906 and are what the DeepSeek V4
+// path actually calls.
+//
+// Every stub ABORTS naming itself: reaching one means the run took a path this build cannot execute, and a silent
+// zero would corrupt the result far from the gate.
+#include <cstdio>
+#include <cstdlib>
+
+#include "strata/kernels/glm_batch.hpp"
+#include "strata/kernels/qwen35_fast.hpp"
+
+namespace {
+[[noreturn]] void gfx906_stub(const char* name) {
+    std::fprintf(stderr,
+                 "\n[gfx906] FATAL: %s is not built on this arch: it lives in the rocWMMA TU "
+                 "(qwen35_fast.cu), which does not compile for gfx906.\n", name);
+    std::fflush(stderr);
+    std::abort();
+}
+}  // namespace
+
+namespace strata::kernels::q35 {
