diff --git a/src/kernels/iq_mxfp4_parity.cpp b/src/kernels/iq_mxfp4_parity.cpp
new file mode 100644
index 0000000..9823106
--- /dev/null
+++ b/src/kernels/iq_mxfp4_parity.cpp
@@ -0,0 +1,126 @@
+// src/kernels/iq_mxfp4_parity.cpp - MXFP4 (ggml type 39) on gfx906 against a CPU reference.
+//
+//     hipcc -x hip --offload-arch=gfx906 -O2 -std=c++17 \
+//       -I include -I include/strata/hip_compat -I third_party/ggml \
+//       src/kernels/iq_mxfp4_parity.cpp src/kernels/cuda/iq_kernels.cu -o iq_mxfp4_parity
+//
+// What is checked, in this order:
+//   1. iq_supported(39) and iq_row_bytes(39, n) == 17 * n / 32   (addressing: this is what returned 0 before).
+//   2. iq_dequant_f32(39) against the block layout decoded on the host: 32 values per 17-byte block, one e8m0
+//      exponent, nibble j -> value j and nibble j+16 -> value j+16, codebook kvalues_fp4 halved.
+//   3. iq_mmvq(39) (q8_1 activations, the expert path) against the float dot -- agreement to activation rounding.
+//
+// No fixture files: the blocks are generated here, so the test runs anywhere the engine runs.
+#include "strata/kernels/iq_kernels.hpp"
+
+#include <cuda_runtime.h>
+
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <random>
+#include <vector>
+
+namespace {
+
+constexpr int BLOCK = 32;            // values per MXFP4 block
+constexpr int BLOCK_BYTES = 17;      // uint8_t e + 16 bytes of nibbles
+// ggml-common.h, kvalues_fp4: the FP4 codebook stored doubled, so the dequant multiplies by 0.5.
+const int8_t KV[16] = {0, 1, 2, 3, 4, 6, 8, 12, 0, -1, -2, -3, -4, -6, -8, -12};
+
+int failures = 0;
+
+void check(bool ok, const char* what) {
+    std::printf("%-58s %s\n", what, ok ? "ok" : "FAIL");
+    if (!ok) ++failures;
+}
+
+double rel_err(const std::vector<float>& got, const std::vector<double>& ref) {
+    double num = 0.0, den = 0.0;
+    for (size_t i = 0; i < ref.size(); ++i) {
+        num += std::fabs((double) got[i] - ref[i]);
+        den += std::fabs(ref[i]);
+    }
+    return num / (den + 1e-30);
+}
+
+}  // namespace
+
+int main() {
+    const int n_blocks = 64;                 // 2048 values: a multiple of 256, so iq_dequant_f32 takes it
+    const int n = n_blocks * BLOCK;
+
+    std::mt19937 rng(1234);
+    std::uniform_int_distribution<int> nib(0, 15);
+    std::uniform_int_distribution<int> expo(120, 136);   // scales 2^-7 .. 2^9: away from the subnormal edge
+
+    std::vector<uint8_t> raw((size_t) n_blocks * BLOCK_BYTES);
+    std::vector<double> ref((size_t) n, 0.0);
+    for (int b = 0; b < n_blocks; ++b) {
+        uint8_t* blk = raw.data() + (size_t) b * BLOCK_BYTES;
+        blk[0] = (uint8_t) expo(rng);                     // e8m0
+        const double scale = std::ldexp(1.0, (int) blk[0] - 127) * 0.5;
+        for (int j = 0; j < 16; ++j) {
+            const uint8_t byte = (uint8_t) ((nib(rng) & 0xF) | ((nib(rng) & 0xF) << 4));
+            blk[1 + j] = byte;
+            ref[(size_t) b * BLOCK + j] = scale * KV[byte & 0xF];
+            ref[(size_t) b * BLOCK + j + 16] = scale * KV[byte >> 4];
+        }
+    }
+
+    cudaStream_t s;
+    if (cudaStreamCreate(&s) != cudaSuccess) {
+        std::printf("cudaStreamCreate failed\n");
+        return 1;
+    }
+
+    // 1. addressing
+    check(strata::kernels::iq_supported(39), "iq_supported(39)");
+    check(strata::kernels::iq_row_bytes(39, n) == (size_t) n_blocks * BLOCK_BYTES,
+          "iq_row_bytes(39, 2048) == 64 * 17");
+
+    void* dw = nullptr;
+    if (cudaMalloc(&dw, raw.size()) != cudaSuccess) {
+        std::printf("cudaMalloc failed\n");
+        return 1;
+    }
+    cudaMemcpy(dw, raw.data(), raw.size(), cudaMemcpyHostToDevice);
+
+    // 2. dequant
+    float* ddq = nullptr;
+    cudaMalloc(&ddq, (size_t) n * 4);
+    strata::kernels::iq_dequant_f32(39, dw, n, ddq, s);
+    std::vector<float> got_dq((size_t) n, 0.0f);
+    cudaMemcpy(got_dq.data(), ddq, (size_t) n * 4, cudaMemcpyDeviceToHost);
+    const double dq_err = rel_err(got_dq, ref);
+    std::printf("iq_dequant_f32(39) relative error: %.3e\n", dq_err);
+    check(dq_err < 1e-6, "dequant matches the block layout decoded on the host");
+
+    // 3. the dot, one row of weights against one q8_1 column
+    std::normal_distribution<float> nd(0.0f, 1.0f);
+    std::vector<float> x((size_t) n);
+    for (auto& v : x) v = nd(rng);
+    double want = 0.0;
+    for (int i = 0; i < n; ++i) want += ref[(size_t) i] * (double) x[(size_t) i];
+
+    float* dx = nullptr;
+    void* xq = nullptr;
+    float* dy = nullptr;
+    cudaMalloc(&dx, (size_t) n * 4);
+    cudaMalloc(&xq, (size_t) n / 32 * sizeof(int8_t) * 36);   // block_q8_1: 36 bytes, generous
+    cudaMalloc(&dy, sizeof(float));
+    cudaMemcpy(dx, x.data(), (size_t) n * 4, cudaMemcpyHostToDevice);
+    strata::kernels::quantize_q8_1_rows(dx, 1, n, xq, s);
+    strata::kernels::iq_mmvq(39, dw, xq, dy, n, 1, 1, s);
+    float got_y = 0.0f;
+    cudaMemcpy(&got_y, dy, sizeof(float), cudaMemcpyDeviceToHost);
+    const double dot_err = std::fabs((double) got_y - want) / (std::fabs(want) + 1e-30);
+    std::printf("iq_mmvq(39) dot: got %.6f want %.6f  relative error %.3e\n", (double) got_y, want, dot_err);
+    check(dot_err < 5e-3, "mmvq dot matches the float dot to activation rounding");
+
+    cudaFree(dw); cudaFree(ddq); cudaFree(dx); cudaFree(xq); cudaFree(dy);
+    cudaStreamDestroy(s);
+
+    std::printf("iq_mxfp4_parity: %s\n", failures == 0 ? "PASS" : "FAIL");
+    return failures == 0 ? 0 : 1;
+}
